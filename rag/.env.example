# copy file to .env and fill in your own values.

# OTLP trace collector endpoint (mcp_server.py). If unset, OTLPSpanExporter
# defaults to http://localhost:4317 (its own standard default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Print metrics to stdout via ConsoleMetricExporter. Off by default.
RAG_OTEL_CONSOLE_EXPORT=false
